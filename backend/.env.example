# Django 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# 重要: .env 文件不应提交到版本控制系统

# Django SECRET_KEY (必须设置，生产环境强烈建议使用强密钥)
# 生成新密钥命令: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Django DEBUG 模式 (生产环境必须设置为 False)
# 开发环境可以设置为 True，生产环境必须为 False
DJANGO_DEBUG=False

# Django ALLOWED_HOSTS (可选，多个值用逗号分隔)
# 如果不设置，将使用 settings.py 中的默认值
# 示例: DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,xiaomanxia.com,www.xiaomanxia.com
# DJANGO_ALLOWED_HOSTS=
